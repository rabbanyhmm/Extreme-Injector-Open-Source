<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>ExtremeInjector.ico</ApplicationIcon>
    <RootNamespace>ExtremeInjector</RootNamespace>
    <AssemblyName>Extreme Injector v3</AssemblyName>
    <Authors>rabbanyhmm</Authors>
    <Company>rabbanyhmm</Company>
    <Product>Extreme Injector</Product>
    <RepositoryUrl>https://github.com/rabbanyhmm/Extreme-Injector-Open-Source</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ExtremeInjector.ico" />
    <None Update="ExtremeInjector.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Native C++ Core DLLs — embedded as resources, zero disk drops at runtime -->
    <EmbeddedResource Include="Resources\InjectorCore32.dll">
      <LogicalName>InjectorCore32.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\InjectorCore64.dll">
      <LogicalName>InjectorCore64.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>